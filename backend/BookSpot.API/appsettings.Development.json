{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceURL": "http://localhost:4566",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "DynamoDB": {
    "ServiceURL": "http://localhost:4566",
    "UseLocalStack": true
  },
  "Jwt": {
    "SecretKey": "local-development-only-jwt-key-not-for-production-use-32chars",
    "Issuer": "BookSpot",
    "Audience": "BookSpot",
    "ExpirationMinutes": "15"
  },
  "Email": {
    "SenderEmail": "noreply@bookspot.test",
    "SenderName": "BookSpot Dev"
  },
  "App": {
    "BaseUrl": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080"
    ],
    "AllowCredentials": true,
    "AllowAllOriginsInDevelopment": true
  }
}
